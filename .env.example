# Neon PostgreSQL pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Admin account; generate the hash with: npm run hash-password -- "your-strong-password"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=scrypt$REPLACE_WITH_GENERATED_HASH

# Set as encrypted Vercel environment variables (32+ random characters each)
SESSION_SECRET=replace-with-a-random-secret-at-least-32-chars
CRON_SECRET=replace-with-a-different-random-secret

# Public HTTPS origin
SITE_URL=https://hulu-zena.vercel.app
